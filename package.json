{
  "name": "trading-bot",
  "version": "1.0.0",
  "description": "Rule-based crypto signal bot: Binance OHLCV, deterministic strategies, optional LLM risk critic.",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "tsx index.ts",
    "signal": "tsx index.ts",
    "build": "tsc -p tsconfig.json",
    "backtest": "tsx scripts/backtest.ts",
    "fetch-backtest-data": "tsx scripts/fetchBacktestData.ts",
    "analyst-snapshot": "tsx scripts/analyst/buildSnapshot.ts",
    "analyst-send": "tsx scripts/analyst/sendDigest.ts",
    "analyst-format": "tsx scripts/analyst/formatDigest.ts",
    "analyst-digest": "tsx scripts/analyst/runDigest.ts",
    "lint": "echo 'no linter configured'",
    "test": "tsx --test src/persistence/paperTrades/paperTradeScaling.test.ts scripts/analyst/generateBias.test.ts scripts/analyst/formatDigest.test.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "binance": "2.15.14",
    "dotenv": "^16.4.5",
